{
  "name": "eslint-plugin-qwqo",
  "version": "0.4.1",
  "type": "module",
  "description": "qwqo ESLint config built on neostandard.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "eslint",
    "eslint-config",
    "eslintconfig",
    "flat-config",
    "typescript",
    "unicorn"
  ],
  "homepage": "https://github.com/sj817/eslint-plugin-qwqo#readme",
  "bugs": "https://github.com/sj817/eslint-plugin-qwqo/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sj817/eslint-plugin-qwqo.git",
    "directory": "packages/eslint-config"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:rules": "node gen-rule-reference.mjs",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "eslint": ">=10.0.0 <11.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "eslint": "10.4.1",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "5.9.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.16.2",
    "eslint-plugin-perfectionist": "5.9.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unicorn": "71.0.0",
    "eslint-plugin-vue": "10.9.2",
    "neostandard": "0.14.1",
    "typescript-eslint": "8.61.0"
  }
}
