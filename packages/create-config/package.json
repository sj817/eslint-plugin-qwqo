{
  "name": "create-qwqo-config",
  "version": "0.4.0",
  "type": "module",
  "description": "Scaffold the qwqo ESLint config interactively.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "create",
    "eslint",
    "config",
    "scaffold",
    "qwqo"
  ],
  "homepage": "https://github.com/sj817/eslint-plugin-qwqo#readme",
  "bugs": "https://github.com/sj817/eslint-plugin-qwqo/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sj817/eslint-plugin-qwqo.git",
    "directory": "packages/create-config"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "create-qwqo-config": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "dependencies": {
    "@clack/prompts": "1.5.1"
  }
}
